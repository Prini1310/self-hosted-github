{
  "name": "VRel-backend",
  "version": "1.0.0",
  "description": "File-system based Git-like backend with JWT auth and SSE log streaming",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node ../tests/run-all-tests.js",
    "test:integration": "node src/utils/integrationCheck.js",
    "demo": "bash ../../demo.sh"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/../tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "testTimeout": 15000
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
